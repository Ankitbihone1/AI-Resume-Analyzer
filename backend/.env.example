# ========================================================================
# AI Resume Analyzer - Backend Environment Variables
# Copy this file to .env and adjust values for your local environment
# ========================================================================

# Server Configuration
SERVER_PORT=8080

# Database Configuration (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=resume_analyzer_db
DB_USERNAME=resume_analyzer_db
DB_PASSWORD=Ankit@2004

# JWT Security Configuration
# Generate a secure 256-bit (32+ chars) secret key for HMAC-SHA256
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
# Expiration time in milliseconds (e.g., 86400000 = 24 hours)
JWT_EXPIRATION_MS=86400000

# AI Provider Configuration
# Options: 'gemini' or 'openai'
AI_PROVIDER=gemini

# Google Gemini API Key (Get free key from https://aistudio.google.com/)
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# OpenAI API Key (Optional alternative)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# File Upload Settings
MAX_FILE_SIZE=10MB
MAX_REQUEST_SIZE=10MB

# CORS Allowed Origins (Comma-separated for React dev server)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
